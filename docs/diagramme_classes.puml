@startuml
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #1A365D
    BorderColor #2B6CB0
}

title **Diagramme de Classes POO — StoreManager Pro (ERP / POS)**

abstract class AbstractEntity {
    #id: ?int
    +getId(): ?int
    +setId(?int id): self
}

class Role extends AbstractEntity {
    -code: string
    -libelle: string
    -description: ?string
    +getCode(): string
    +getLibelle(): string
    +getDescription(): ?string
}

class StatutDette extends AbstractEntity {
    -code: string
    -libelle: string
    +getCode(): string
    +getLibelle(): string
    +isSoldee(): bool
    +isNonSoldee(): bool
}

class ModePaiement extends AbstractEntity {
    -code: string
    -libelle: string
    -estActif: bool
    +getCode(): string
    +getLibelle(): string
    +isEstActif(): bool
}

class StatutAppro extends AbstractEntity {
    -code: string
    -libelle: string
    +getCode(): string
    +getLibelle(): string
}

class Categorie extends AbstractEntity {
    -code: string
    -libelle: string
    -description: ?string
    +getCode(): string
    +getLibelle(): string
    +getDescription(): ?string
}

class User extends AbstractEntity {
    -nom: string
    -prenom: string
    -email: string
    -motDePasse: string
    -role: ?Role
    -actif: bool
    -dateCreation: ?DateTime
    +getNomComplet(): string
    +getEmail(): string
    +getRole(): ?Role
    +hasRole(codeRole: string): bool
    +verifierMotDePasse(plainPassword: string): bool
    +setMotDePasse(plainPassword: string): void
    +isActif(): bool
}

class Produit extends AbstractEntity {
    -code: string
    -libelle: string
    -description: ?string
    -prixAchat: float
    -prixVente: float
    -qteStock: int
    -seuilAlerte: int
    -categorie: ?Categorie
    -dateCreation: ?DateTime
    +getCode(): string
    +getLibelle(): string
    +getPrixAchat(): float
    +getPrixVente(): float
    +getQteStock(): int
    +getSeuilAlerte(): int
    +getCategorie(): ?Categorie
    +estEnAlerte(): bool
    +calculerMarge(): float
    +calculerTauxMarge(): float
    +ajouterStock(quantite: int): void
    +retirerStock(quantite: int): bool
}

class Client extends AbstractEntity {
    -nom: string
    -prenom: string
    -telephone: string
    -email: ?string
    -adresse: ?string
    -limiteCredit: float
    -totalDettesActuelles: float
    -dateCreation: ?DateTime
    +getNomComplet(): string
    +getTelephone(): string
    +getEmail(): ?string
    +getAdresse(): ?string
    +getLimiteCredit(): float
    +getTotalDettesActuelles(): float
    +getCreditDisponible(): float
    +peutPrendreCredit(montant: float): bool
    +ajouterDette(montant: float): void
    +diminuerDette(montant: float): void
}

class Fournisseur extends AbstractEntity {
    -nom: string
    -contactNom: ?string
    -telephone: string
    -email: ?string
    -adresse: ?string
    -dateCreation: ?DateTime
    +getNom(): string
    +getContactNom(): ?string
    +getTelephone(): string
    +getEmail(): ?string
    +getAdresse(): ?string
}

class Vente extends AbstractEntity {
    -numeroFacture: string
    -dateVente: DateTime
    -montantTotal: float
    -montantPaye: float
    -montantRestant: float
    -modePaiement: ?ModePaiement
    -statut: string
    -client: ?Client
    -vendeur: ?User
    -lignes: LigneVente[*]
    -dateCreation: ?DateTime
    +getNumeroFacture(): string
    +getDateVente(): DateTime
    +getMontantTotal(): float
    +getMontantPaye(): float
    +getMontantRestant(): float
    +getModePaiement(): ?ModePaiement
    +getClient(): ?Client
    +getVendeur(): ?User
    +getLignes(): LigneVente[*]
    +ajouterLigne(ligne: LigneVente): void
    +calculerTotal(): float
    +estACredit(): bool
}

class Commande extends Vente {
}

class LigneVente extends AbstractEntity {
    -vente: ?Vente
    -produit: ?Produit
    -quantite: int
    -prixUnitaire: float
    -remise: float
    -sousTotal: float
    +getVente(): ?Vente
    +getProduit(): ?Produit
    +getQuantite(): int
    +getPrixUnitaire(): float
    +getRemise(): float
    +calculerSousTotal(): float
}

class Dette extends AbstractEntity {
    -vente: ?Vente
    -client: ?Client
    -montantTotal: float
    -montantRestant: float
    -dateCreation: DateTime
    -dateEcheance: ?DateTime
    -statut: ?StatutDette
    -paiements: Paiement[*]
    +getVente(): ?Vente
    +getClient(): ?Client
    +getMontantTotal(): float
    +getMontantRestant(): float
    +getDateCreation(): DateTime
    +getDateEcheance(): ?DateTime
    +getStatut(): ?StatutDette
    +getPaiements(): Paiement[*]
    +enregistrerPaiement(paiement: Paiement): void
    +estSoldee(): bool
    +estEnRetard(): bool
}

class Paiement extends AbstractEntity {
    -dette: ?Dette
    -montant: float
    -datePaiement: DateTime
    -modePaiement: ?ModePaiement
    -referencePaiement: ?string
    -agent: ?User
    -dateCreation: ?DateTime
    +getDette(): ?Dette
    +getMontant(): float
    +getDatePaiement(): DateTime
    +getModePaiement(): ?ModePaiement
    +getReferencePaiement(): ?string
    +getAgent(): ?User
}

class Approvisionnement extends AbstractEntity {
    -numeroBL: string
    -dateAppro: DateTime
    -montantTotal: float
    -statut: ?StatutAppro
    -fournisseur: ?Fournisseur
    -agentStock: ?User
    -lignes: LigneApprovisionnement[*]
    -dateCreation: ?DateTime
    +getNumeroBL(): string
    +getDateAppro(): DateTime
    +getMontantTotal(): float
    +getStatut(): ?StatutAppro
    +getFournisseur(): ?Fournisseur
    +getAgentStock(): ?User
    +getLignes(): LigneApprovisionnement[*]
    +ajouterLigne(ligne: LigneApprovisionnement): void
    +calculerTotal(): float
    +isRecu(): bool
    +isAnnule(): bool
}

class LigneApprovisionnement extends AbstractEntity {
    -approvisionnement: ?Approvisionnement
    -produit: ?Produit
    -quantite: int
    -prixAchatUnitaire: float
    -sousTotal: float
    +getApprovisionnement(): ?Approvisionnement
    +getProduit(): ?Produit
    +getQuantite(): int
    +getPrixAchatUnitaire(): float
    +getSousTotal(): float
}

User "1" --> "1" Role : possede
User "1" --> "0..*" Vente : enregistre
User "1" --> "0..*" Paiement : encaisse
User "1" --> "0..*" Approvisionnement : receptionne

Produit "0..*" --> "0..1" Categorie : classe dans

Client "1" --> "0..*" Vente : commande
Client "1" --> "0..*" Dette : est debiteur de

Vente "1" *-- "1..*" LigneVente : compose de
LigneVente "0..*" --> "1" Produit : reference

Vente "1" --> "0..1" Dette : genere
Dette "1" *-- "0..*" Paiement : reglee par
Dette "1" --> "1" StatutDette : possede statut
Dette "1" --> "1" Client : debiteur

Fournisseur "1" --> "0..*" Approvisionnement : approvisionne
Approvisionnement "1" *-- "1..*" LigneApprovisionnement : compose de
Approvisionnement "1" --> "1" StatutAppro : possede statut
LigneApprovisionnement "0..*" --> "1" Produit : reference

Vente "1" --> "1" ModePaiement : regle par
Paiement "1" --> "1" ModePaiement : regle par

@enduml
