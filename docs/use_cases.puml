@startuml
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam shadowing false

skinparam actor {
    BackgroundColor #EDF2F7
    BorderColor #2B6CB0
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    ArrowColor #2B6CB0
}

title **Diagramme de Cas d'Utilisation — StoreManager Pro (ERP / POS)**

left to right direction

actor " Admin Boutique\n(Admin)" as Admin
actor " Chargé de Vente\n(Vente)" as Vente
actor " Chargé de Stock\n(Stock)" as Stock
actor " Inventaire\n(Inventaire)" as Inventaire

Admin --|> Vente
Admin --|> Stock
Admin --|> Inventaire
Stock --|> Inventaire

package " Authentification & Profils" {
    usecase "S'authentifier (Email / Password)" as UC_Login
    usecase "Se déconnecter" as UC_Logout
}

package " Caisse Tactile (POS) & Ventes" {
    usecase "Consulter Registre Général des Ventes & Commandes" as UC_SearchProd
    usecase "Choisir la méthode de paiement" as UC_Cart
    usecase "Calculer le montant total net à payer" as UC_Montant
    usecase "Sélectionner un client" as UC_SelectClient
    usecase "Valider la vente" as UC_ValiderVente
    usecase "Contrôler limite de crédit" as UC_CheckCredit
    usecase "Décrémenter le stock" as UC_DecStock
    usecase "Sélectionner des articles" as UC_PrintTicket
}

package " Gestion des Dettes & Règlements" {
    usecase "Consulter paiements enregistrés d'un client" as UC_ViewDebts
    usecase "Enregistrer un paiement / remboursement" as UC_PayDebt
    usecase "Mettre à jour statut dette (SOLDEE)" as UC_UpdateDebtStatus
    usecase "Consulter articles de la vente d'un client " as UC_ClientDebtHistory
}

package " Approvisionnements & Réception Marchandises" {
    usecase "Consulter détails réception commande produit" as UC_StockAlerts
    usecase "Enregistrer Bon de Livraison (BL)" as UC_CreateBL
    usecase "Incrémenter le stock produits" as UC_IncStock
    usecase "Saisir les quantités reçues" as UC_QteRecue
    usecase "Valider la réception en stock" as UC_SelectSupplier
}

package " Catalogue & Répertoires Tiers" {
    usecase "Gérer les produits" as UC_ManageProd
    usecase "Gérer les clients" as UC_ManageClients
    usecase "Gérer les fournisseurs" as UC_ManageSuppliers
    usecase "Consulter & compter les stocks (Audit)" as UC_AuditStock
}

package " Dashboard, Pilotage & Administration" {
    usecase "Consulter Dashboard (CA, Marge, Dettes)" as UC_Dashboard
    usecase "Gérer utilisateurs et rôles" as UC_ManageUsers
    usecase "Consulter rapports d'audit" as UC_Reports
}

Admin --> UC_Login
Admin --> UC_Logout
Vente --> UC_Login
Vente --> UC_Logout
Stock --> UC_Login
Stock --> UC_Logout
Inventaire --> UC_Login
Inventaire --> UC_Logout

Vente --> UC_SearchProd
Vente --> UC_ValiderVente

Vente --> UC_ViewDebts
Vente --> UC_PayDebt
Vente --> UC_ClientDebtHistory

Stock --> UC_StockAlerts
Stock --> UC_CreateBL

Inventaire --> UC_AuditStock
Inventaire --> UC_ManageProd
Inventaire --> UC_ManageClients
Inventaire --> UC_ManageSuppliers

Admin --> UC_Dashboard
Admin --> UC_ManageUsers
Admin --> UC_Reports

UC_PrintTicket ..> UC_Montant : <<include>>
UC_ValiderVente ..> UC_DecStock : <<include>>
UC_ValiderVente ..> UC_PrintTicket : <<include>>
UC_ValiderVente ..> UC_Cart : <<include>>
UC_ValiderVente <.. UC_CheckCredit : <<extend>>
UC_ValiderVente <.. UC_SelectClient : <<extend>>

UC_PayDebt ..> UC_UpdateDebtStatus : <<include>>

UC_CreateBL ..> UC_IncStock : <<include>>
UC_CreateBL ..> UC_SelectSupplier : <<include>>
UC_CreateBL <.. UC_QteRecue : <<extend>>

@enduml
